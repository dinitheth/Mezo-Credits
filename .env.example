# Copy to .env (never commit .env)
# Every value here is public browser configuration. Never put a private key
# or seed phrase in a VITE_* variable.

# InvoiceRouter on Mezo testnet (chain 31611). Constructor argument: MUSD.
VITE_ROUTER_ADDRESS_TESTNET=0xYourRouterOn31611
VITE_ROUTER_ADDRESS_MAINNET=

# FlowVault on Mezo testnet. Constructor arguments: MUSD and Mezo PriceFeed.
# Testnet PriceFeed: 0x86bCF0841622a5dAC14A313a15f96A95421b9366
# Mainnet PriceFeed: 0xc5aC5A8892230E0A3e1c473881A2de7353fFcA88
VITE_VAULT_ADDRESS_TESTNET=0xYourVaultOn31611
VITE_VAULT_ADDRESS_MAINNET=

# Block where the app starts reading router events (the router deploy block).
VITE_FLOW_START_BLOCK_TESTNET=
VITE_FLOW_START_BLOCK_MAINNET=

# Optional MEZO token address for display only.
VITE_MEZO_TOKEN_TESTNET=
VITE_MEZO_TOKEN_MAINNET=

# Copy to .env (never commit .env)
VITE_ROUTER_ADDRESS_TESTNET=0xYourRouterOn31611
VITE_ROUTER_ADDRESS_MAINNET=
VITE_VAULT_ADDRESS_TESTNET=0xYourVaultOn31611
VITE_VAULT_ADDRESS_MAINNET=
VITE_MEZO_TOKEN_TESTNET=
VITE_MEZO_TOKEN_MAINNET=
# Optional: turns on the global wallet kit (email/social + wallet sign-in).
# Get an environment ID at https://app.dynamic.xyz — leave empty to use
# the built-in wallet connection only.
VITE_DYNAMIC_ENVIRONMENT_ID=
